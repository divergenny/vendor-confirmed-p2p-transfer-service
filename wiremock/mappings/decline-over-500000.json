{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/api/v1/payments",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.amount > 500000)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"reference\": \"{{jsonPath request.body '$.reference'}}\", \"status\": \"DECLINED\"}",
    "transformers": ["response-template"]
  }
}
