# Copy this file to .env and put your own values there. .env is not committed.
# docker compose and the app started from the IDE both read .env.
DB_NAME=p2p_transfer
DB_USER=postgres
DB_PASSWORD=postgres
# signs the login tokens: at least 32 characters, e.g. from "openssl rand -base64 48"
JWT_SECRET=dev-only-secret-change-me-0123456789
